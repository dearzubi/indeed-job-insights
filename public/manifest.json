{
  "manifest_version": 3,
  "name": "Indeed Job Insights",
  "version": "0.1.0",
  "description": "Surfaces driving time, keyword hits, must-have skills, and employer insights on Indeed job listings.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Indeed Job Insights",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.indeed.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://*.indeed.com/*", "https://routes.googleapis.com/*"],
  "permissions": ["storage", "activeTab"]
}
